<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#121212">

    <!-- Nombre de la Congregación en el Encabezado -->
    <TextView
        android:id="@+id/tv_congregacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Super CircuitoApp"
        android:textColor="#4DA3E8"
        android:textStyle="bold"
        android:textSize="14sp"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Línea divisoria: LinearLayout en vez de View plano (View no es compatible con RemoteViews/widgets) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#264888"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp" />

    <!-- Programa de Comida -->
    <TextView
        android:id="@+id/tv_comida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🍽️ Comida: Sin asignar"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Visita de Pastoreo del día -->
    <TextView
        android:id="@+id/tv_pastoreo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏠 Pastoreo: Ninguno hoy"
        android:textColor="#5CE875"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Actividad programada del día -->
    <TextView
        android:id="@+id/tv_actividad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔔 Actividad: Ninguna"
        android:textColor="#FFD060"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Servicio del Campo (Benjamín y Beatriz) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_grupo_benjamin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Benjamín: -"
            android:textColor="#B0BEC5"
            android:textSize="10.5sp"
            android:maxLines="4"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_grupo_beatriz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Beatriz: -"
            android:textColor="#B0BEC5"
            android:textSize="10.5sp"
            android:paddingStart="4dp"
            android:maxLines="4"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>

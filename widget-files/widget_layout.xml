<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <!-- Sección de Comida -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🍽️ Programa de Comida"
        android:textColor="#81D4FA"
        android:textStyle="bold"
        android:textSize="14sp" />
        
    <TextView
        android:id="@+id/tv_comida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sin asignar"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp" />

    <!-- Sección de Servicio -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💼 Servicio del Campo"
        android:textColor="#FFB74D"
        android:textStyle="bold"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <!-- Grupo de Benjamín -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Benjamín:"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />
                
            <TextView
                android:id="@+id/tv_grupo_benjamin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Grupo de Beatriz -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beatriz:"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />
                
            <TextView
                android:id="@+id/tv_grupo_beatriz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
